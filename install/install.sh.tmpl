#!/bin/sh
# @@NAME@@ installer, version @@VERSION@@ — generated by `make installer`; do not edit the output.
#
#   curl -fsSL <url>/install.sh | sudo sh
#
# Installs Docker if it is missing, then runs the @@NAME@@ panel as a Docker Compose project
# with its data in @@DATA_DIR@@. Running it again is safe: it keeps the data and recreates the
# panel container from the configured image.
#
# Environment overrides:
#   @@PREFIX@@IMAGE       image to run (default @@IMAGE@@:@@VERSION@@)
#   @@PREFIX@@PUBLIC_URL  base URL for printed links (default http://<detected address>)
#   @@PREFIX@@PULL        "never" to use an image already loaded on this host
set -eu

NAME="@@NAME@@"
SLUG="@@SLUG@@"
DATA_DIR="@@DATA_DIR@@"
PULL="${@@PREFIX@@PULL:-always}"
COMPOSE_FILE="$DATA_DIR/compose.yaml"
ENV_FILE="$DATA_DIR/panel.env"
# A re-run keeps the image the panel runs now: it may have updated itself past the version
# this installer was made for. Set @@PREFIX@@IMAGE to switch images explicitly.
IMAGE="${@@PREFIX@@IMAGE:-}"
if [ -z "$IMAGE" ] && [ -f "$COMPOSE_FILE" ]; then
  IMAGE=$(sed -n 's/^[[:space:]]*image:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$COMPOSE_FILE" | head -n1)
fi
IMAGE="${IMAGE:-@@IMAGE@@:@@VERSION@@}"

say() { printf '  %s\n' "$*"; }
step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
die() { printf '\n\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

START=$(date +%s)

step "Checking the server"
[ "$(id -u)" -eq 0 ] || die "run as root, e.g. curl -fsSL <url>/install.sh | sudo sh"
[ "$(uname -s)" = "Linux" ] || die "$NAME runs on Linux only (this is $(uname -s))"
case "$(uname -m)" in
  x86_64 | amd64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *) die "unsupported architecture $(uname -m); amd64 and arm64 are supported" ;;
esac
OS="unknown"
if [ -r /etc/os-release ]; then
  # shellcheck disable=SC1091
  OS=$(. /etc/os-release && echo "${PRETTY_NAME:-$ID}")
fi
say "$OS, $ARCH"

# A re-run finds its own proxy on 80/443; only a fresh install needs them free.
installed=false
if command -v docker >/dev/null 2>&1 && docker container inspect "$SLUG" >/dev/null 2>&1; then
  installed=true
  say "existing installation found; it is updated in place"
fi
if [ "$installed" = false ]; then
  for port in 80 443; do
    if command -v ss >/dev/null 2>&1; then
      if ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; then
        die "port $port is in use; $NAME's proxy needs ports 80 and 443 (stop the web server using it)"
      fi
    else
      say "cannot check port $port (no ss); continuing"
    fi
  done
  say "ports 80 and 443 are free"
fi

step "Docker"
if ! command -v docker >/dev/null 2>&1; then
  command -v curl >/dev/null 2>&1 || die "curl is needed to install Docker"
  say "installing Docker Engine from get.docker.com"
  curl -fsSL https://get.docker.com | sh
fi
if ! docker info >/dev/null 2>&1; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now docker >/dev/null 2>&1 || true
  fi
  docker info >/dev/null 2>&1 || die "the Docker daemon is not running"
fi
docker compose version >/dev/null 2>&1 || die "the Docker Compose plugin is missing (install docker-compose-plugin)"
say "Docker $(docker version --format '{{.Server.Version}}'), $(docker compose version --short 2>/dev/null || echo compose)"

step "Data directory and network"
mkdir -p "$DATA_DIR"
chmod 700 "$DATA_DIR"
docker network inspect "$SLUG" >/dev/null 2>&1 || docker network create "$SLUG" >/dev/null
say "$DATA_DIR, Docker network $SLUG"

# The address printed in the setup link: the one the default route leaves from. Behind
# NAT that is a private address; set @@PREFIX@@PUBLIC_URL to override.
if [ -z "${@@PREFIX@@PUBLIC_URL:-}" ]; then
  addr=""
  if command -v ip >/dev/null 2>&1; then
    addr=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n1)
  fi
  [ -n "$addr" ] || addr=$(hostname -I 2>/dev/null | awk '{print $1}')
  PUBLIC_URL="http://${addr:-<server-ip>}"
else
  PUBLIC_URL="${@@PREFIX@@PUBLIC_URL%/}"
fi

# panel.env is kept across runs, so a hand edit survives a re-install; only the public
# URL is refreshed when the caller sets it.
if [ ! -f "$ENV_FILE" ] || [ -n "${@@PREFIX@@PUBLIC_URL:-}" ]; then
  printf '@@PREFIX@@PUBLIC_URL=%s\n' "$PUBLIC_URL" >"$ENV_FILE"
  chmod 600 "$ENV_FILE"
fi

cat >"$COMPOSE_FILE" <<EOF
# Written by the $NAME installer. Re-running the installer rewrites this file.
name: $SLUG

services:
  $SLUG:
    image: $IMAGE
    container_name: $SLUG # the proxy reaches the panel as $SLUG:8080
    restart: unless-stopped
    env_file: panel.env
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # Same path inside and out: containers the panel starts bind-mount host paths
      # under it, and the proxy's admin socket lives there.
      - $DATA_DIR:$DATA_DIR
    ports:
      - "127.0.0.1:8080:8080" # direct access from the server itself, for recovery
    networks: [$SLUG]
    stop_grace_period: 20s
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }

networks:
  $SLUG:
    name: $SLUG
    external: true
EOF

step "Starting $NAME"
if [ "$PULL" = "never" ]; then
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE is not on this host (and @@PREFIX@@PULL=never)"
  say "using the local image $IMAGE"
else
  docker compose -f "$COMPOSE_FILE" pull --quiet
fi
docker compose -f "$COMPOSE_FILE" up -d --pull never --remove-orphans

say "waiting for the panel"
i=0
until docker exec "$SLUG" wget -qO /dev/null http://127.0.0.1:8080/api/health 2>/dev/null; do
  i=$((i + 1))
  [ "$i" -lt 60 ] || die "the panel did not become healthy; see: docker logs $SLUG"
  sleep 1
done

# A host command that runs the panel CLI inside the container.
cat >/usr/local/bin/"$SLUG" <<EOF
#!/bin/sh
# Runs the $NAME CLI inside its container. Written by the installer.
if [ -t 0 ] && [ -t 1 ]; then exec docker exec -it $SLUG panel "\$@"; fi
exec docker exec -i $SLUG panel "\$@"
EOF
chmod 755 /usr/local/bin/"$SLUG"

ELAPSED=$(($(date +%s) - START))
step "$NAME is running (${ELAPSED}s)"
if docker exec "$SLUG" wget -qO- http://127.0.0.1:8080/api/meta 2>/dev/null | grep -q '"setup_required":true'; then
  docker exec "$SLUG" panel setup-token
  say "Lost the link or let it expire? Run: $SLUG setup-token"
else
  say "Already set up. Open $PUBLIC_URL and sign in."
  say "Forgot the password? Run: $SLUG owner reset-password"
fi
